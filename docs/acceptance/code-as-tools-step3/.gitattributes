# Publication indexes and retained evidence use exact file-byte hashes.
# Preserve CRLF bytes while retaining ordinary whitespace checks.
/identity-evidence.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/validation/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/validation/*.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/validation/*.xml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
