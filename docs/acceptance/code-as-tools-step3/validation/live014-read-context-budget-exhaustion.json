      "original_generated_content": "import json, re\nfrom pathlib import Path\nfrom orca_task_sdk import run_orca\n\nreceipt = run_orca(\"job.inp\", dependencies=(\"ethanol.xyz\",), request_key=\"ethanol_optfreq\")\nfiles = receipt.get(\"files\", {}) or {}\n\ndef read(path):\n    try:\n        return Path(path).read_text(encoding=\"utf-8\", errors=\"replace\")\n    except Exception:\n        return \"\"\n\ndef choose(pred):\n    for k in files:\n        if pred(k):\n            return k\n    return None\n\nxyz_key = choose(lambda k: k.lower().endswith(\".xyz\"))\nout_key = choose(lambda k: \"stdout\" in k.lower())\n\ndef parse_xyz(path):\n    lines = read(path).splitlines()\n    for i, line in enumerate(lines):\n        s = line.strip()\n        if s.isdigit():\n            n = int(s)\n            if i + 2 + n <= len(lines):\n                atoms = []\n                ok = True\n                for j in range(i + 2, i + 2 + n):\n                    p = lines[j].split()\n                    if len(p) < 4:\n                        ok = False\n                        break\n                    try:\n                        atoms.append({\"element\": p[0], \"x\": float(p[1]), \"y\": float(p[2]), \"z\": float(p[3])})\n                    except Exception:\n                        ok = False\n                        break\n                if ok and atoms:\n                    return atoms\n    return None\n\ndef parse_freqs(text):\n    vals = []\n    pat = re.compile(r\"^\\s*(\\d+):\\s+(-?\\d+(?:\\.\\d+)?)\\s+cm\\*\\*-1\")\n    for line in text.splitlines():\n        m = pat.match(line)\n        if m:\n            v = float(m.group(2))\n            if abs(v) > 1e-8:\n                vals.append(v)\n    return vals\n\nxyz_atoms = parse_xyz(files.get(xyz_key)) if xyz_key else None\nfreqs = parse_freqs(read(files.get(out_key))) if out_key else []\n\nobs = []\nif xyz_atoms:\n    obs.append({\"name\": \"optimized_geometry\", \"value\": xyz_atoms, \"unit\": \"angstrom\", \"sources\": [{\"internal_request_key\": receipt.get(\"request_key\"), \"filename\": xyz_key, \"location\": None}], \"limitations\": [\"Geometry parsed from ORCA Opt+Freq output; scientific qualification is not implied.\"]})\nif freqs:\n    obs.append({\"name\": \"vibrational_frequencies\", \"value\": freqs, \"unit\": \"cm^-1\", \"sources\": [{\"internal_request_key\": receipt.get(\"request_key\"), \"filename\": out_key, \"location\": \"VIBRATIONAL FREQUENCIES\"}], \"limitations\": [\"Frequencies parsed from ORCA output; imaginary modes or convergence should be reviewed.\"]})\nPath(\"observations.json\").write_text(json.dumps({\"version\": 1, \"observations\": obs}, indent=2), encoding=\"utf-8\")\n\nresult = {\"request_key\": receipt.get(\"request_key\"), \"input_fingerprint\": receipt.get(\"input_fingerprint\"), \"operation_status\": receipt.get(\"operation_status\"), \"scientific_validation\": receipt.get(\"scientific_validation\"), \"actual_conditions\": receipt.get(\"actual_conditions\"), \"files\": files}\n",
