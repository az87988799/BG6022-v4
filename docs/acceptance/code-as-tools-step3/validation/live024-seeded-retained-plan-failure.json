    "text": "CODE_TOOLS_DEVELOPMENT_FAULT_V1\nimport json\nimport os\nimport re\n\nfrom orca_task_sdk import run_orca\n\nXYZ_NAME = \"ethanol.xyz\"\nINPUT_NAME = \"job.inp\"\nREQUEST_KEY = \"ethanol-opt-freq-1\"\n\ndef build_input():\n    return \"\"\"! B3LYP 6-31G* Opt Freq TightSCF NORI NoAutoStart RKS\n%pal\n  nprocs 4\nend\n%maxcore 192\n%scf\n  MaxIter 256\n  ConvForced true\n  AutoTRAH false\nend\n%geom\n  MaxIter 128\n  EnforceStrictConvergence true\nend\n%method\n  Z_MaxIter 128\nend\n* xyzfile 0 1 ethanol.xyz\n\"\"\"\n\ndef read_from_files(files, predicate):\n    for original_name, path in files.items():\n        if predicate(original_name):\n            try:\n                with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as handle:\n                    return original_name, handle.read()\n            except OSError:\n                continue\n    return None, \"\"\n\ndef parse_frequencies(text):\n    values = []\n    in_block = False\n    pattern = re.compile(r\"^\\s*(\\d+):\\s+(-?\\d+\\.\\d+)\\s+cm\\*\\*-1\")\n    for line in text.splitlines():\n        if \"VIBRATIONAL FREQUENCIES\" in line:\n            in_block = True\n            continue\n        if not in_block:\n            continue\n        if \"NORMAL MODES\" in line or \"IR SPECTRUM\" in line:\n            break\n        match = pattern.match(line)\n        if match:\n            values.append(float(match.group(2)))\n    return values\n\nwith open(INPUT_NAME, \"w\", encoding=\"utf-8\") as handle:\n    handle.write(build_input())\n\nreceipt = run_orca(INPUT_NAME, dependencies=(XYZ_NAME,), request_key=REQUEST_KEY)\nfiles = receipt.get(\"files\", {})\n\noptimized_name, optimized_text = read_from_files(\n    files, lambda name: name.endswith(\"job.xyz\")\n)\nif not optimized_text:\n    optimized_name, optimized_text = read_from_files(\n        files, lambda name: name.endswith(\".xyz\") and not name.endswith(XYZ_NAME)\n    )\n\nstdout_name, stdout_text = read_from_files(\n    files, lambda name: name.endswith(\"stdout.out\") or name.endswith(\"job.out\")\n)\nfrequencies = parse_frequencies(stdout_text)\n\nobservations = {\n    \"version\": 1,\n    \"observations\": [\n        {\n            \"name\": \"optimized_geometry\",\n            \"value\": optimized_text,\n            \"unit\": None,\n            \"sources\": [\n                {\n                    \"internal_request_key\": receipt.get(\"request_key\", REQUEST_KEY),\n                    \"filename\": optimized_name or \"job.xyz\",\n                    \"location\": \"final optimized geometry\",\n                }\n            ],\n            \"limitations\": [\n                \"B3LYP/6-31G* gas-phase optimization; not a basis-set-limit benchmark\"\n            ],\n        },\n        {\n            \"name\": \"vibrational_frequencies\",\n            \"value\": frequencies,\n            \"unit\": \"cm^-1\",\n            \"sources\": [\n                {\n                    \"internal_request_key\": receipt.get(\"request_key\", REQUEST_KEY),\n                    \"filename\": stdout_name or \"stdout.out\",\n                    \"location\": \"VIBRATIONAL FREQUENCIES block\",\n                }\n            ],\n            \"limitations\": [\n                \"harmonic frequencies from ORCA Freq; no anharmonic correction\"\n            ],\n        },\n    ],\n}\n\nwith open(\"observations.json\", \"w\", encoding=\"utf-8\") as handle:\n    json.dump(observations, handle, indent=2, allow_nan=False)\nprint(json.dumps({\"request_key\": receipt.get(\"request_key\"), \"files\": list(files.keys()), \"frequency_count\": len(frequencies)}))\n"
  },
