    "artifact_id": "artifact_91e6854b9cf64bd58a85746cc743a1c6",
    "result_id": "result_502906d4f17a4f6db313c85ff9a1f469",
    "artifact": {
      "path": "data/code-tools-step3/live-store/artifacts/artifact_91e6854b9cf64bd58a85746cc743a1c6/files/ethanol_optfreq.py",
      "bytes": 2577,
      "sha256": "6504d9a50cee85c3eb75bb693a2c7a5899000c935f4df7e956d5ac4eba7a12af"
    },
    "line_count": 65,
    "exact_text": "import json, os, re\nfrom orca_task_sdk import run_orca\n\n\ndef _read(path):\n    with open(path, 'r', encoding='utf-8', errors='replace') as f:\n        return f.read()\n\n\ndef _find_file(files, name):\n    for k, v in files.items():\n        if k.lower() == name.lower():\n            return k, v\n    return None, None\n\n\ndef main():\n    geom = 'ethanol.xyz'\n    if not os.path.exists(geom):\n        raise SystemExit('missing geometry dependency ethanol.xyz')\n    inp = '''! B3LYP def2-SVP Opt Freq TightSCF RKS NORI NoAutoStart\n%pal nprocs 4 end\n%maxcore 192\n%scf MaxIter 256 ConvForced true AutoTRAH false end\n%geom MaxIter 128 EnforceStrictConvergence true end\n%method Z_MaxIter 128 end\n* xyzfile 0 1 ethanol.xyz\n'''\n    with open('job.inp', 'w', encoding='utf-8') as f:\n        f.write(inp)\n    receipt = run_orca('job.inp', dependencies=('ethanol.xyz',), request_key='ethanol_optfreq')\n    files = receipt.get('files', {})\n    print('files:', sorted(files))\n    stdout_key, stdout_path = _find_file(files, 'stdout.out')\n    xyz_key, xyz_path = _find_file(files, 'job.xyz')\n    if xyz_path is None:\n        raise SystemExit('job.xyz not found in ORCA files')\n    lines = _read(xyz_path).splitlines()\n    n = int(lines[0].strip())\n    atoms = []\n    coords = []\n    for line in lines[2:2 + n]:\n        parts = line.split()\n        atoms.append(parts[0])\n        coords.append([float(x) for x in parts[1:4]])\n    freqs = []\n    if stdout_path:\n        text = _read(stdout_path)\n        m = re.search(r'VIBRATIONAL FREQUENCIES(.*?)(?:\\n\\s*NORMAL MODES|\\Z)', text, re.S)\n        sec = m.group(1) if m else text\n        for line in sec.splitlines():\n            mm = re.match(r'\\s*\\d+:\\s+([-+]?\\d+\\.\\d+)\\s+cm\\*\\*-1', line)\n            if mm:\n                freqs.append(float(mm.group(1)))\n    rk = receipt.get('request_key', 'ethanol_optfreq')\n    obs = [\n        {'name': 'optimized_geometry', 'value': {'atoms': atoms, 'coordinates': coords}, 'unit': None, 'sources': [{'internal_request_key': rk, 'filename': xyz_key or 'job.xyz', 'location': 'final XYZ'}], 'limitations': []},\n        {'name': 'vibrational_frequencies', 'value': freqs, 'unit': 'cm^-1', 'sources': [{'internal_request_key': rk, 'filename': stdout_key or 'stdout.out', 'location': 'VIBRATIONAL FREQUENCIES'}], 'limitations': ['Harmonic frequencies from the same Opt+Freq calculation; no thermochemistry or standard-state corrections.']}\n    ]\n    with open('observations.json', 'w', encoding='utf-8') as f:\n        json.dump({'version': 1, 'observations': obs}, f, indent=2)\n\n\nif __name__ == '__main__':\n    main()\n",
    "proposal_to_call_to_artifact_bytes_match": true,
    "embedded_native_input": "! B3LYP def2-SVP Opt Freq TightSCF RKS NORI NoAutoStart\n%pal nprocs 4 end\n%maxcore 192\n%scf MaxIter 256 ConvForced true AutoTRAH false end\n%geom MaxIter 128 EnforceStrictConvergence true end\n%method Z_MaxIter 128 end\n* xyzfile 0 1 ethanol.xyz\n",
    "embedded_native_input_sha256": "8e537060a09f801eeddc60f939620775b267752ab10fb9382e34271897739b20",
