          "text": "    sources.append({\"internal_request_key\": p[\"request_key\"], \"filename\": \"stdout.out\", \"location\": \"FINAL SINGLE POINT ENERGY; job.xyz final geometry\"})"
        },
        {
          "line": 149,
          "text": ""
        },
        {
          "line": 150,
          "text": "rel_points = [{\"requested_angle_deg\": p[\"requested_angle_deg\"], \"actual_dihedral_deg\": p[\"actual_dihedral_deg\"], \"relative_energy_kj_mol\": p[\"relative_energy_kj_mol\"], \"converged\": p[\"converged\"]} for p in points]"
        },
        {
          "line": 151,
          "text": ""
        },
        {
          "line": 152,
          "text": "rationale = \"B3LYP/def2-TZVP. ORCA 6.1 manual: B3LYP is the popular hybrid functional with 20% HF exchange (result_39c1b61f90a54983910f5843208f55e2); def2-TZVP is the Karlsruhe polarized valence triple-zeta basis for H-Rn (result_d087eafacb914c6fb00979050e3579a0). No dispersion correction is applied because the retrieved official excerpts did not document a B3LYP dispersion correction. Gas phase, neutral (charge 0), singlet RKS.\""
        },
        {
          "line": 153,
          "text": ""
        },
        {
          "line": 154,
          "text": "criterion = \"Criterion stated before scanning: use the 60-degree grid; if the lowest-energy converged grid point has at least one neighboring interval with |DeltaE| > 5 kJ/mol, or any adjacent converged pair differs by > 10 kJ/mol, propose at most two additional constrained optimizations at midpoint angles adjacent to the minimum or steepest interval. If the minimum is bracketed by neighbor differences <= 5 kJ/mol on both sides, or no converged points exist, stop without extra angles.\""
        },
        {
          "line": 155,
          "text": "sorted_conv = sorted([p for p in points if p[\"converged\"] and p[\"relative_energy_kj_mol\"] is not None], key=lambda p: p[\"requested_angle_deg\"])"
        },
        {
          "line": 156,
          "text": "max_adj_delta = None"
        },
        {
          "line": 157,
          "text": "if len(sorted_conv) >= 2:"
        },
        {
          "line": 158,
          "text": "    deltas = [abs(sorted_conv[i+1][\"relative_energy_kj_mol\"] - sorted_conv[i][\"relative_energy_kj_mol\"]) for i in range(len(sorted_conv)-1)]"
        },
        {
          "line": 159,
          "text": "    max_adj_delta = max(deltas)"
        },
        {
          "line": 160,
          "text": "if len(sorted_conv) >= 2 and max_adj_delta is not None and max_adj_delta > 10:"
        },
        {
          "line": 161,
          "text": "    recommendation = \"provisional: the converged grid shows a steep adjacent energy change (>10 kJ/mol); propose up to two midpoint angles adjacent to the minimum or steepest interval, with final choice made in the main decision loop after inspecting the full curve.\""
        },
        {
          "line": 162,
          "text": "elif len(sorted_conv) >= 2:"
        },
        {
          "line": 163,
          "text": "    recommendation = \"provisional: no additional angles according to the stated criterion; the converged grid's adjacent changes are <=10 kJ/mol and the minimum is bracketed without a >5 kJ/mol neighbor trigger.\""
        },
        {
          "line": 164,
          "text": "else:"
