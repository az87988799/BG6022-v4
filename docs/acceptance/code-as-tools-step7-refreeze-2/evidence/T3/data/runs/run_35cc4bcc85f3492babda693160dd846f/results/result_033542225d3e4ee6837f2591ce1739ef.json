          "text": "    copied = {}"
        },
        {
          "line": 101,
          "text": "    for key, src in files.items():"
        },
        {
          "line": 102,
          "text": "        safe = re.sub(r\"[^A-Za-z0-9_.-]+\", \"_\", str(key))"
        },
        {
