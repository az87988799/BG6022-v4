      "lines": [
        {
          "line": 1,
          "text": "import os, json, math, shutil, re"
        },
        {
          "line": 2,
          "text": "from orca_task_sdk import run_orca"
        },
        {
          "line": 3,
          "text": ""
        },
        {
          "line": 4,
          "text": "INITIAL_XYZ = \"initial.xyz\""
        },
        {
          "line": 5,
          "text": "ANGLES = [-180, -120, -60, 0, 60, 120, 180]"
        },
        {
          "line": 6,
          "text": "LABELS = {-180:\"m180\", -120:\"m120\", -60:\"m60\", 0:\"0\", 60:\"60\", 120:\"120\", 180:\"180\"}"
        },
        {
          "line": 7,
          "text": "HARTREE_TO_KJ = 2625.499639"
        },
        {
          "line": 8,
          "text": ""
        },
        {
          "line": 9,
          "text": ""
        },
        {
          "line": 10,
          "text": "def parse_xyz(path):"
        },
        {
          "line": 11,
          "text": "    with open(path, \"r\") as f:"
        },
        {
          "line": 12,
          "text": "        lines = [ln.rstrip(\"\\n\") for ln in f]"
        },
        {
          "line": 13,
          "text": "    n = int(lines[0].split()[0])"
        },
        {
          "line": 14,
          "text": "    atoms = []"
        },
        {
          "line": 15,
          "text": "    for ln in lines[2:2+n]:"
        },
        {
          "line": 16,
          "text": "        p = ln.split()"
        },
        {
          "line": 17,
          "text": "        if len(p) < 4:"
        },
        {
          "line": 18,
          "text": "            continue"
        },
        {
          "line": 19,
          "text": "        atoms.append((p[0], float(p[1]), float(p[2]), float(p[3])))"
        },
        {
          "line": 20,
          "text": "    return atoms"
        },
        {
          "line": 21,
          "text": ""
        },
        {
          "line": 22,
          "text": ""
        },
        {
          "line": 23,
          "text": "def sub(a,b): return (a[0]-b[0], a[1]-b[1], a[2]-b[2])"
        },
        {
          "line": 24,
          "text": "def dot(a,b): return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]"
        },
        {
          "line": 25,
          "text": "def cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])"
        },
        {
          "line": 26,
          "text": "def norm(a):"
        },
        {
          "line": 27,
          "text": "    n = math.sqrt(dot(a,a))"
        },
        {
          "line": 28,
          "text": "    return (a[0]/n, a[1]/n, a[2]/n)"
        },
        {
          "line": 29,
          "text": ""
        },
        {
          "line": 30,
          "text": ""
        },
        {
          "line": 31,
          "text": "def dihedral_deg(a,b,c,d):"
        },
        {
          "line": 32,
          "text": "    p0 = (a[1],a[2],a[3]); p1 = (b[1],b[2],b[3]); p2 = (c[1],c[2],c[3]); p3 = (d[1],d[2],d[3])"
        },
        {
          "line": 33,
          "text": "    b0 = sub(p1,p0); b1 = sub(p2,p1); b2 = sub(p3,p2); b1n = norm(b1)"
        },
        {
          "line": 34,
          "text": "    v = sub(b0, tuple(b1n[k]*dot(b0,b1n) for k in range(3)))"
        },
        {
          "line": 35,
          "text": "    w = sub(b2, tuple(b1n[k]*dot(b2,b1n) for k in range(3)))"
        },
        {
          "line": 36,
          "text": "    x = dot(v,w); y = dot(cross(b1n,v),w)"
        },
        {
          "line": 37,
          "text": "    return math.degrees(math.atan2(y,x))"
        },
        {
          "line": 38,
          "text": ""
        },
        {
          "line": 39,
          "text": ""
        },
        {
          "line": 40,
          "text": "def find_dihedral_indices(atoms):"
        },
        {
          "line": 41,
          "text": "    carbons = [i for i,a in enumerate(atoms) if a[0].upper() == \"C\"]"
        },
        {
          "line": 42,
          "text": "    adj = {i:[] for i in carbons}"
        },
        {
          "line": 43,
          "text": "    for ii,i in enumerate(carbons):"
        },
        {
          "line": 44,
          "text": "        for j in carbons[ii+1:]:"
        },
        {
          "line": 45,
          "text": "            d = math.sqrt(sum((atoms[i][k+1]-atoms[j][k+1])**2 for k in range(3)))"
        },
        {
          "line": 46,
          "text": "            if d <= 1.75:"
        },
        {
          "line": 47,
          "text": "                adj[i].append(j); adj[j].append(i)"
        },
        {
          "line": 48,
          "text": "    best = []"
        },
        {
          "line": 49,
          "text": "    for s in carbons:"
        },
        {
          "line": 50,
          "text": "        stack = [(s, [s])]"
        },
        {
          "line": 51,
          "text": "        while stack:"
        },
        {
          "line": 52,
          "text": "            cur, path = stack.pop()"
        },
        {
          "line": 53,
          "text": "            if len(path) > len(best):"
        },
        {
          "line": 54,
          "text": "                best = path"
        },
        {
          "line": 55,
          "text": "            for nxt in adj[cur]:"
        },
        {
          "line": 56,
          "text": "                if nxt not in path:"
        },
        {
          "line": 57,
          "text": "                    stack.append((nxt, path+[nxt]))"
        },
        {
          "line": 58,
          "text": "    if len(best) < 4:"
        },
        {
          "line": 59,
          "text": "        raise RuntimeError(\"Could not find a four-carbon chain; carbons=%s adj=%s\" % (carbons, adj))"
        },
        {
          "line": 60,
          "text": "    return best[:4]"
        },
        {
          "line": 61,
          "text": ""
        },
        {
          "line": 62,
          "text": ""
        },
        {
          "line": 63,
          "text": "def write_input(angle, idxs):"
        },
        {
          "line": 64,
          "text": "    i,j,k,l = idxs"
        },
        {
          "line": 65,
          "text": "    inp_name = \"scan_%s.inp\" % LABELS[angle]"
