          "text": "    })"
        },
        {
          "line": 136,
          "text": ""
        },
        {
          "line": 137,
          "text": "conv_energies = [p[\"energy_hartree\"] for p in points if p[\"converged\"] and p[\"energy_hartree\"] is not None]"
        },
        {
          "line": 138,
          "text": "all_energies = [p[\"energy_hartree\"] for p in points if p[\"energy_hartree\"] is not None]"
        },
        {
          "line": 139,
          "text": "ref = min(conv_energies) if conv_energies else (min(all_energies) if all_energies else None)"
