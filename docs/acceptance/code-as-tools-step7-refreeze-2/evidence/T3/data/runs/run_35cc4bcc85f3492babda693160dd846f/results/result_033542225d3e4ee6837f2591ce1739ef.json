          "line": 67,
          "text": "      \"! B3LYP def2-TZVP RKS Opt NoAutoStart\","
        },
        {
          "line": 68,
          "text": "      \"%maxcore 192\","
        },
        {
          "line": 69,
          "text": "      \"%scf\","
        },
        {
          "line": 70,
          "text": "      \"  MaxIter 256\","
        },
        {
          "line": 71,
          "text": "      \"  AutoTRAH false\","
        },
        {
          "line": 72,
          "text": "      \"end\","
        },
        {
          "line": 73,
          "text": "      \"%geom\","
        },
        {
          "line": 74,
          "text": "      \"  MaxIter 128\","
        },
        {
          "line": 75,
          "text": "      \"  Constraints\","
        },
        {
          "line": 76,
          "text": "      \"    { D %d %d %d %d %.1f C }\" % (i,j,k,l,angle),"
        },
        {
          "line": 77,
          "text": "      \"  end\","
        },
        {
          "line": 78,
          "text": "      \"end\","
        },
        {
          "line": 79,
          "text": "      \"* xyzfile 0 1 initial.xyz\","
        },
        {
          "line": 80,
          "text": "    ]"
        },
        {
          "line": 81,
          "text": "    with open(inp_name,\"w\") as f:"
        },
        {
          "line": 82,
          "text": "        f.write(\"\\n\".join(lines)+\"\\n\")"
        },
        {
          "line": 83,
          "text": "    return inp_name"
        },
        {
          "line": 84,
          "text": ""
        },
        {
          "line": 85,
          "text": ""
        },
        {
