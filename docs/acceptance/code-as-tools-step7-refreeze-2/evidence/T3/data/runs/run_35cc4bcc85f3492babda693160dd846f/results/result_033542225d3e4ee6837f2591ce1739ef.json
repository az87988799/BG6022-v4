          "text": "decision = {\"criterion\": criterion, \"max_adjacent_converged_delta_kj_mol\": max_adj_delta, \"n_converged\": len(sorted_conv), \"recommendation\": recommendation, \"status\": \"preliminary_main_loop_decides\"}"
