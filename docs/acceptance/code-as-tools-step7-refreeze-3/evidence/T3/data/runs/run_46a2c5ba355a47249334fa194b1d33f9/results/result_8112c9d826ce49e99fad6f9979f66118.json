      "lines": [
        {
          "line": 1,
          "text": "import json, math, re, shutil"
        },
        {
          "line": 2,
          "text": "from pathlib import Path"
        },
        {
          "line": 3,
          "text": "from orca_task_sdk import run_orca, checkpoint"
        },
        {
          "line": 4,
          "text": ""
        },
        {
          "line": 5,
          "text": "ANGLES = [-180, -120, -60, 0, 60, 120, 180]"
        },
        {
          "line": 6,
          "text": "GEOM = 'butane_initial.xyz'"
        },
        {
          "line": 7,
          "text": "HARTREE_TO_KJ = 2625.4996394799"
        },
        {
          "line": 8,
          "text": "REFINEMENT_CRITERION = ("
        },
        {
          "line": 9,
          "text": "    'Predeclared refinement rule: after the seven coarse constrained optimizations, sort points by actual dihedral. '"
        },
        {
          "line": 10,
          "text": "    'Refine only if (i) adjacent relative energies show a slope sign change bracketing an interior extremum, or '"
        },
        {
          "line": 11,
          "text": "    '(ii) an adjacent pair differs by >2.0 kJ/mol while the lower-energy point is not at a requested angle and a midpoint could lower the energy by >0.5 kJ/mol; add at most two midpoints. '"
        },
        {
          "line": 12,
          "text": "    'Do not refine if the coarse curve is monotonic, all adjacent differences <0.5 kJ/mol, or convergence failures prevent reliable comparison. '"
        },
        {
          "line": 13,
          "text": "    'This is a numerical sampling criterion, not transition-state validation.'"
        },
        {
          "line": 14,
          "text": ")"
        },
        {
          "line": 15,
          "text": ""
        },
        {
          "line": 16,
          "text": "def read_lines(path):"
        },
        {
          "line": 17,
          "text": "    with open(path, 'r', encoding='utf-8', errors='replace') as f:"
        },
        {
          "line": 18,
          "text": "        return f.readlines()"
        },
        {
          "line": 19,
          "text": ""
        },
        {
          "line": 20,
          "text": "def parse_xyz(path):"
        },
        {
          "line": 21,
          "text": "    lines = read_lines(path)"
        },
        {
          "line": 22,
          "text": "    n = int(lines[0].split()[0])"
        },
        {
          "line": 23,
          "text": "    atoms = []"
        },
        {
          "line": 24,
          "text": "    for line in lines[2:2+n]:"
        },
        {
          "line": 25,
          "text": "        p = line.split()"
        },
        {
          "line": 26,
          "text": "        atoms.append((p[0], float(p[1]), float(p[2]), float(p[3])))"
        },
        {
          "line": 27,
          "text": "    return atoms"
        },
        {
          "line": 28,
          "text": ""
        },
        {
          "line": 29,
          "text": "def vsub(a,b):"
        },
        {
          "line": 30,
          "text": "    return (a[0]-b[0], a[1]-b[1], a[2]-b[2])"
        },
        {
          "line": 31,
          "text": ""
        },
        {
          "line": 32,
          "text": "def vdot(a,b):"
        },
        {
          "line": 33,
          "text": "    return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]"
        },
        {
          "line": 34,
          "text": ""
        },
        {
          "line": 35,
          "text": "def vcross(a,b):"
        },
        {
          "line": 36,
          "text": "    return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])"
        },
        {
          "line": 37,
          "text": ""
        },
        {
          "line": 38,
          "text": "def vscale(a,s):"
        },
        {
          "line": 39,
          "text": "    return (a[0]*s, a[1]*s, a[2]*s)"
        },
        {
          "line": 40,
          "text": ""
        },
        {
          "line": 41,
          "text": "def vnorm(a):"
        },
        {
          "line": 42,
          "text": "    return math.sqrt(vdot(a,a))"
        },
        {
          "line": 43,
          "text": ""
        },
        {
          "line": 44,
          "text": "def dist(a,b):"
        },
        {
          "line": 45,
          "text": "    return math.sqrt(sum((a[i]-b[i])**2 for i in range(1,4)))"
        },
        {
          "line": 46,
          "text": ""
        },
        {
          "line": 47,
          "text": "def carbon_indices(atoms):"
        },
        {
          "line": 48,
          "text": "    carbons = [i for i,a in enumerate(atoms) if a[0].upper() == 'C']"
        },
        {
          "line": 49,
          "text": "    if len(carbons) != 4:"
        },
        {
          "line": 50,
          "text": "        raise ValueError('expected 4 carbons in butane, got %d' % len(carbons))"
        },
        {
          "line": 51,
          "text": "    adj = {i: [] for i in carbons}"
        },
        {
          "line": 52,
          "text": "    for i in carbons:"
        },
        {
          "line": 53,
          "text": "        for j in carbons:"
        },
        {
          "line": 54,
          "text": "            if i < j and dist(atoms[i], atoms[j]) < 1.8:"
        },
        {
          "line": 55,
          "text": "                adj[i].append(j); adj[j].append(i)"
        },
        {
          "line": 56,
          "text": "    ends = [i for i in carbons if len(adj[i]) == 1]"
        },
        {
          "line": 57,
          "text": "    if len(ends) != 2:"
        },
        {
          "line": 58,
          "text": "        raise ValueError('could not find butane carbon chain endpoints: %s' % str(ends))"
        },
        {
          "line": 59,
          "text": "    start, target = ends"
        },
        {
          "line": 60,
          "text": "    stack = [(start, [start])]"
        },
        {
          "line": 61,
          "text": "    while stack:"
        },
        {
          "line": 62,
          "text": "        node, path = stack.pop()"
        },
        {
          "line": 63,
          "text": "        if node == target and len(path) == 4:"
        },
        {
          "line": 64,
          "text": "            return path"
        },
        {
          "line": 65,
          "text": "        for nb in adj[node]:"
        },
        {
          "line": 66,
          "text": "            if nb not in path:"
        },
        {
          "line": 67,
          "text": "                stack.append((nb, path + [nb]))"
        },
        {
          "line": 68,
          "text": "    raise ValueError('could not order four-carbon chain')"
        },
        {
          "line": 69,
          "text": ""
        },
        {
          "line": 70,
          "text": "def dihedral_deg(atoms, idx):"
        },
        {
          "line": 71,
          "text": "    p0 = atoms[idx[0]][1:]"
        },
        {
          "line": 72,
          "text": "    p1 = atoms[idx[1]][1:]"
        },
        {
          "line": 73,
          "text": "    p2 = atoms[idx[2]][1:]"
        },
        {
          "line": 74,
          "text": "    p3 = atoms[idx[3]][1:]"
        },
        {
          "line": 75,
          "text": "    b0 = vsub(p0,p1)"
        },
        {
          "line": 76,
          "text": "    b1 = vsub(p2,p1)"
        },
        {
          "line": 77,
          "text": "    b2 = vsub(p3,p2)"
        },
        {
          "line": 78,
          "text": "    b1n = vscale(b1, 1.0/vnorm(b1))"
        },
        {
          "line": 79,
          "text": "    v = vsub(b0, vscale(b1n, vdot(b0,b1n)))"
        },
        {
          "line": 80,
          "text": "    w = vsub(b2, vscale(b1n, vdot(b2,b1n)))"
        },
        {
          "line": 81,
          "text": "    x = vdot(v,w)"
        },
        {
          "line": 82,
          "text": "    y = vdot(vcross(b1n,v),w)"
        },
        {
          "line": 83,
          "text": "    return math.degrees(math.atan2(y,x))"
        },
        {
          "line": 84,
          "text": ""
        },
        {
          "line": 85,
          "text": "def read_text_if_exists(path):"
        },
        {
          "line": 86,
          "text": "    try:"
        },
        {
          "line": 87,
          "text": "        with open(path, 'r', encoding='utf-8', errors='replace') as f:"
        },
        {
          "line": 88,
          "text": "            return f.read()"
        },
        {
          "line": 89,
          "text": "    except Exception:"
        },
        {
          "line": 90,
          "text": "        return ''"
        },
        {
          "line": 91,
          "text": ""
        },
        {
          "line": 92,
          "text": "def find_text(files):"
        },
        {
          "line": 93,
          "text": "    for key in ['stdout.out','job.out','output.out']:"
        },
        {
          "line": 94,
          "text": "        if key in files:"
        },
        {
          "line": 95,
          "text": "            return key, files[key]"
        },
        {
          "line": 96,
          "text": "    for key,path in files.items():"
        },
        {
          "line": 97,
          "text": "        if key.lower().endswith('.out'):"
        },
        {
          "line": 98,
          "text": "            return key, path"
        },
        {
          "line": 99,
          "text": "    return None, None"
        },
        {
          "line": 100,
          "text": ""
        },
        {
          "line": 101,
          "text": "def last_energy(text):"
        },
        {
          "line": 102,
          "text": "    ms = re.findall(r'FINAL SINGLE POINT ENERGY\\s+(-?\\d+(?:\\.\\d+)?)', text)"
        },
        {
          "line": 103,
          "text": "    return float(ms[-1]) if ms else None"
        },
        {
          "line": 104,
          "text": ""
        },
        {
          "line": 105,
          "text": "def is_converged(text):"
        },
        {
          "line": 106,
          "text": "    return ('HURRAY! THE OPTIMIZATION HAS CONVERGED' in text) or ('THE OPTIMIZATION HAS CONVERGED' in text)"
        },
        {
          "line": 107,
          "text": ""
        },
        {
          "line": 108,
          "text": "atoms = parse_xyz(GEOM)"
        },
        {
          "line": 109,
          "text": "cidx = carbon_indices(atoms)"
        },
        {
          "line": 110,
          "text": "orca_idx = [i+1 for i in cidx]"
        },
        {
          "line": 111,
          "text": "Path('refinement_criterion.txt').write_text(REFINEMENT_CRITERION + '\\n', encoding='utf-8')"
        },
        {
          "line": 112,
          "text": ""
        },
        {
          "line": 113,
          "text": "records = []"
        },
        {
          "line": 114,
          "text": "sources_by_name = {name: [] for name in ['sampling','energy','optimized_geometry','member_table','energy_difference','sampling_check','random_seed']}"
        },
        {
          "line": 115,
          "text": ""
        },
        {
          "line": 116,
          "text": "for angle in ANGLES:"
        },
        {
          "line": 117,
          "text": "    tag = str(angle).replace('-', 'm')"
        },
        {
          "line": 118,
          "text": "    key = 'coarse_dihedral_' + tag"
