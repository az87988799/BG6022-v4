        },
        {
          "line": 155,
          "text": "            out_log = 'member_' + tag + '.out'"
        },
        {
          "line": 156,
          "text": "            Path(out_log).write_text(text, encoding='utf-8')"
        },
        {
          "line": 157,
          "text": "            rec['stdout_file'] = out_log"
        },
        {
          "line": 158,
          "text": "            loc_e = 'FINAL SINGLE POINT ENERGY' if rec['energy_hartree'] is not None else 'optimization/convergence log'"
        },
        {
          "line": 159,
          "text": "            sources_by_name['energy'].append({'internal_request_key': key, 'filename': log_key, 'location': loc_e})"
