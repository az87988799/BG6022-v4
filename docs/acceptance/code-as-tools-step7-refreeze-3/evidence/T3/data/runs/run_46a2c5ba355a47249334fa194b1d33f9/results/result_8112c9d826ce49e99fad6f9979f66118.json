          "text": "            rec['actual_angle_deg'] = dihedral_deg(final_atoms, cidx)"
        },
        {
          "line": 148,
          "text": "            sources_by_name['optimized_geometry'].append({'internal_request_key': key, 'filename': geom_key, 'location': 'final optimized geometry'})"
        },
        {
          "line": 149,
          "text": "            sources_by_name['member_table'].append({'internal_request_key': key, 'filename': geom_key, 'location': 'final optimized geometry'})"
        },
        {
          "line": 150,
          "text": "        log_key, log_path = find_text(files)"
        },
        {
          "line": 151,
          "text": "        if log_key:"
        },
        {
