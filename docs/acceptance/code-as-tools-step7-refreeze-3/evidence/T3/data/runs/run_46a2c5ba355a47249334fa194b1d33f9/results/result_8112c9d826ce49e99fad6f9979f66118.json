        {
          "line": 171,
          "text": ""
        },
        {
          "line": 172,
          "text": "success = [r for r in records if r.get('energy_hartree') is not None and not r.get('error')]"
        },
        {
          "line": 173,
          "text": "min_e = min([r['energy_hartree'] for r in success]) if success else None"
