          "text": "    inp = 'scan_' + tag + '.inp'"
        },
        {
          "line": 120,
          "text": "    input_text = '! r2SCAN-3c RKS NoAutoStart\\n%maxcore 192\\n%scf\\n  MaxIter 256\\n  AutoTRAH false\\nend\\n%geom\\n  MaxIter 128\\n  Constraints\\n    {D %d %d %d %d %.1f C}\\n  end\\nend\\n* xyzfile 0 1 %s\\n' % (orca_idx[0], orca_idx[1], orca_idx[2], orca_idx[3], float(angle), GEOM)"
        },
        {
          "line": 121,
          "text": "    Path(inp).write_text(input_text, encoding='utf-8')"
        },
        {
          "line": 122,
          "text": "    rec = {"
        },
        {
          "line": 123,
          "text": "        'requested_angle_deg': angle,"
        },
        {
          "line": 124,
          "text": "        'actual_angle_deg': None,"
        },
        {
          "line": 125,
          "text": "        'energy_hartree': None,"
        },
        {
          "line": 126,
          "text": "        'converged': False,"
        },
        {
          "line": 127,
          "text": "        'structure_file': None,"
        },
        {
          "line": 128,
          "text": "        'stdout_file': None,"
        },
        {
          "line": 129,
          "text": "        'stderr_file': None,"
        },
        {
          "line": 130,
          "text": "        'request_key': key,"
        },
        {
          "line": 131,
          "text": "        'operation_status': None,"
        },
        {
          "line": 132,
          "text": "        'error': None,"
        },
        {
