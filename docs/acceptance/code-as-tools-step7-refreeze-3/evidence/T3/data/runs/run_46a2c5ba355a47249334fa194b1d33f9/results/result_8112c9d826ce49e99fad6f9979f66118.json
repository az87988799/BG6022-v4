          "text": "            sources_by_name['sampling'].append({'internal_request_key': key, 'filename': log_key, 'location': 'requested dihedral %s deg' % angle})"
        },
        {
          "line": 162,
          "text": "        if 'stderr.txt' in files:"
        },
        {
