        },
        {
          "line": 185,
          "text": "        \"unit\": \"atomic units\","
        },
        {
          "line": 186,
          "text": "        \"sources\": [src1],"
        },
        {
          "line": 187,
          "text": "        \"formula\": \"ORCA static dipole-dipole polarizability raw cartesian tensor\","
        },
        {
          "line": 188,
          "text": "        \"artifacts\": [\"original.xyz\", \"orca_original.inp\", \"original_stdout.out\", \"rotation_record.json\"],"
        },
        {
