      "lines": [
        {
          "line": 1,
          "text": "import json, math, os"
        },
        {
          "line": 2,
          "text": "from rdkit import Chem"
        },
        {
          "line": 3,
          "text": "from rdkit.Chem import AllChem, rdMolAlign"
        },
        {
          "line": 4,
          "text": "from orca_task_sdk import run_orca, receipt_source"
        },
        {
          "line": 5,
          "text": ""
        },
        {
          "line": 6,
          "text": "SEED = 1701"
        },
        {
          "line": 7,
          "text": "THRESH = 0.15"
        },
        {
          "line": 8,
          "text": "N_EMBED = 60"
        },
        {
          "line": 9,
          "text": "N_ORCA = 5"
        },
        {
          "line": 10,
          "text": "HKJ = 2625.499639"
        },
        {
          "line": 11,
          "text": "METHOD = 'B3LYP'"
        },
        {
          "line": 12,
          "text": "BASIS = 'def2-SVP'"
        },
        {
          "line": 13,
          "text": "CHARGE = 0"
        },
        {
          "line": 14,
          "text": "MULT = 1"
        },
        {
          "line": 15,
          "text": ""
        },
        {
          "line": 16,
          "text": ""
        },
        {
          "line": 17,
          "text": "def conf_xyz(mol, cid, comment):"
        },
        {
          "line": 18,
          "text": "    c = mol.GetConformer(cid)"
        },
        {
          "line": 19,
          "text": "    out = [str(mol.GetNumAtoms()), comment]"
        },
        {
          "line": 20,
          "text": "    for i, a in enumerate(mol.GetAtoms()):"
        },
        {
          "line": 21,
          "text": "        p = c.GetAtomPosition(i)"
        },
        {
          "line": 22,
          "text": "        out.append('%s %.6f %.6f %.6f' % (a.GetSymbol(), p.x, p.y, p.z))"
        },
        {
          "line": 23,
          "text": "    return '\\n'.join(out) + '\\n'"
        },
        {
          "line": 24,
          "text": ""
        },
        {
          "line": 25,
          "text": ""
        },
        {
          "line": 26,
          "text": "mol = Chem.AddHs(Chem.MolFromSmiles('CCCCCC'))"
        },
        {
          "line": 27,
          "text": "ps = AllChem.ETKDGv3()"
        },
        {
          "line": 28,
          "text": "ps.randomSeed = SEED"
        },
        {
          "line": 29,
          "text": "ps.numThreads = 1"
        },
        {
          "line": 30,
          "text": "ps.pruneRmsThresh = -1.0"
        },
        {
          "line": 31,
          "text": "AllChem.EmbedMultipleConfs(mol, numConfs=N_EMBED, params=ps)"
        },
        {
          "line": 32,
          "text": "conf_ids = [c.GetId() for c in mol.GetConformers()]"
        },
        {
          "line": 33,
          "text": "ffres = AllChem.MMFFOptimizeMoleculeConfs(mol, maxIters=2000, numThreads=1)"
        },
        {
          "line": 34,
          "text": ""
        },
        {
          "line": 35,
          "text": "cands = []"
        },
        {
          "line": 36,
          "text": "for i, cid in enumerate(conf_ids):"
        },
        {
          "line": 37,
          "text": "    nconv, e = ffres[i]"
        },
        {
          "line": 38,
          "text": "    fn = 'cand_%02d.xyz' % (i + 1)"
        },
        {
          "line": 39,
          "text": "    with open(fn, 'w') as fh:"
        },
        {
          "line": 40,
          "text": "        fh.write(conf_xyz(mol, cid, 'n-hexane %s RDKit ETKDGv3 seed=1701 MMFF94' % fn))"
        },
        {
          "line": 41,
          "text": "    cands.append({'id': fn[:-4], 'file': fn, 'cid': cid,"
        },
        {
          "line": 42,
          "text": "                  'mmff_kcal_mol': float(e), 'ff_converged': bool(nconv == 0)})"
        },
        {
          "line": 43,
          "text": ""
        },
        {
          "line": 44,
          "text": ""
        },
        {
          "line": 45,
          "text": "def heavy_conf(cid):"
        },
        {
          "line": 46,
          "text": "    m = Chem.Mol(mol)"
        },
        {
          "line": 47,
          "text": "    m.RemoveAllConformers()"
        },
        {
          "line": 48,
          "text": "    m.AddConformer(Chem.Conformer(mol.GetConformer(cid)), assignId=True)"
        },
        {
          "line": 49,
          "text": "    return Chem.RemoveHs(m)"
        },
        {
          "line": 50,
          "text": ""
        },
        {
          "line": 51,
          "text": ""
        },
        {
          "line": 52,
          "text": "def heavy_rmsd(h1, h2):"
        },
        {
          "line": 53,
          "text": "    try:"
        },
        {
          "line": 54,
          "text": "        return float(rdMolAlign.GetBestRMS(h1, h2, prbId=0, refId=0))"
        },
        {
          "line": 55,
          "text": "    except Exception:"
        },
        {
          "line": 56,
          "text": "        c1 = h1.GetConformer(0)"
        },
        {
          "line": 57,
          "text": "        c2 = h2.GetConformer(0)"
        },
        {
          "line": 58,
          "text": "        n = h1.GetNumAtoms()"
        },
        {
          "line": 59,
          "text": "        best = None"
        },
        {
          "line": 60,
          "text": "        for rev in (False, True):"
        },
        {
          "line": 61,
          "text": "            s = 0.0"
        },
        {
          "line": 62,
          "text": "            for i in range(n):"
        },
        {
          "line": 63,
          "text": "                p = c1.GetAtomPosition(i)"
        },
        {
          "line": 64,
          "text": "                q = c2.GetAtomPosition(n - 1 - i if rev else i)"
        },
        {
          "line": 65,
          "text": "                s += (p.x - q.x) ** 2 + (p.y - q.y) ** 2 + (p.z - q.z) ** 2"
        },
        {
          "line": 66,
          "text": "            r = math.sqrt(s / n)"
        },
        {
          "line": 67,
          "text": "            best = r if best is None else min(best, r)"
        },
        {
          "line": 68,
          "text": "        return float(best)"
        },
        {
          "line": 69,
          "text": ""
        },
        {
          "line": 70,
          "text": ""
        },
        {
          "line": 71,
          "text": "byid = {}"
        },
        {
          "line": 72,
          "text": "heavies = {}"
        },
        {
          "line": 73,
          "text": "kept = []"
        },
        {
          "line": 74,
          "text": "for cand in sorted(cands, key=lambda r: (r['mmff_kcal_mol'], r['id'])):"
        },
        {
          "line": 75,
          "text": "    h = heavy_conf(cand['cid'])"
        },
        {
          "line": 76,
          "text": "    heavies[cand['id']] = h"
        },
        {
          "line": 77,
          "text": "    byid[cand['id']] = cand"
        },
        {
          "line": 78,
          "text": "    best = None"
        },
        {
          "line": 79,
          "text": "    bestid = None"
        },
        {
          "line": 80,
          "text": "    for k in kept:"
        },
        {
          "line": 81,
          "text": "        r = heavy_rmsd(h, heavies[k])"
        },
        {
          "line": 82,
          "text": "        if best is None or r < best:"
        },
        {
          "line": 83,
          "text": "            best = r"
        },
        {
          "line": 84,
          "text": "            bestid = k"
        },
        {
          "line": 85,
          "text": "    cand['min_rmsd_A'] = None if best is None else round(best, 4)"
        },
        {
          "line": 86,
          "text": "    if best is not None and best < THRESH:"
        },
        {
          "line": 87,
          "text": "        cand['duplicate_of'] = bestid"
        },
        {
          "line": 88,
          "text": "    else:"
        },
        {
          "line": 89,
          "text": "        cand['duplicate_of'] = None"
        },
        {
          "line": 90,
          "text": "        kept.append(cand['id'])"
        },
        {
          "line": 91,
          "text": ""
        },
        {
          "line": 92,
          "text": "selected_ids = kept[:N_ORCA]"
        },
        {
          "line": 93,
          "text": ""
        },
        {
          "line": 94,
          "text": "ORCA_INP = '! RKS B3LYP def2-SVP SP NoAutoStart\\n%maxcore 192\\n%scf\\n  MaxIter 256\\n  AutoTRAH false\\nend\\n* xyzfile 0 1 {xyz}\\n'"
        },
        {
          "line": 95,
          "text": ""
        },
        {
          "line": 96,
          "text": "runs = []"
        },
        {
          "line": 97,
          "text": "for cid_ in selected_ids:"
        },
        {
          "line": 98,
          "text": "    c = byid[cid_]"
        },
        {
          "line": 99,
          "text": "    inp = 'sp_%s.inp' % cid_"
        },
        {
          "line": 100,
          "text": "    with open(inp, 'w') as fh:"
        },
        {
          "line": 101,
          "text": "        fh.write(ORCA_INP.format(xyz=c['file']))"
        },
        {
          "line": 102,
          "text": "    rec = run_orca(inp, dependencies=[c['file']], request_key='sp_' + cid_, purpose='new_candidate')"
        },
        {
          "line": 103,
          "text": "    energy = None"
        },
        {
          "line": 104,
          "text": "    files = rec.get('files') or {}"
        },
        {
          "line": 105,
          "text": "    p = files.get('stdout.out')"
        },
        {
          "line": 106,
          "text": "    if p and os.path.exists(p):"
        },
        {
          "line": 107,
          "text": "        try:"
        },
        {
          "line": 108,
          "text": "            txt = open(p, 'r', errors='replace').read()"
        },
        {
          "line": 109,
          "text": "        except Exception:"
        },
        {
          "line": 110,
          "text": "            txt = ''"
        },
        {
          "line": 111,
          "text": "        for line in txt.splitlines():"
        },
        {
          "line": 112,
          "text": "            s = line.strip()"
        },
        {
          "line": 113,
          "text": "            if s.startswith('FINAL SINGLE POINT ENERGY'):"
        },
        {
          "line": 114,
          "text": "                try:"
        },
        {
          "line": 115,
          "text": "                    energy = float(s.split()[-1])"
        },
        {
          "line": 116,
          "text": "                except Exception:"
        },
        {
          "line": 117,
          "text": "                    pass"
        },
        {
          "line": 118,
          "text": "    try:"
        },
        {
          "line": 119,
          "text": "        src = receipt_source(rec, 'stdout.out', location='FINAL SINGLE POINT ENERGY (last occurrence)')"
        },
        {
          "line": 120,
          "text": "    except Exception:"
        },
        {
          "line": 121,
          "text": "        src = {'internal_request_key': rec.get('request_key'), 'filename': 'stdout.out',"
        },
        {
          "line": 122,
          "text": "               'location': 'FINAL SINGLE POINT ENERGY (last occurrence)'}"
        },
        {
          "line": 123,
          "text": "    runs.append({'candidate': cid_, 'xyz': c['file'], 'input': inp,"
        },
        {
          "line": 124,
          "text": "                 'energy_hartree': energy, 'source': src})"
        },
        {
          "line": 125,
          "text": ""
        },
        {
          "line": 126,
          "text": "ok = [r for r in runs if r['energy_hartree'] is not None]"
        },
        {
          "line": 127,
          "text": "low = None"
        },
        {
          "line": 128,
          "text": "if ok:"
        },
        {
          "line": 129,
          "text": "    emin = min(r['energy_hartree'] for r in ok)"
        },
        {
          "line": 130,
          "text": "    for r in ok:"
        },
        {
          "line": 131,
          "text": "        r['relative_kj_mol'] = round((r['energy_hartree'] - emin) * HKJ, 4)"
        },
        {
          "line": 132,
          "text": "    low = min(ok, key=lambda r: r['energy_hartree'])['candidate']"
        },
        {
          "line": 133,
          "text": "for r in runs:"
        },
        {
          "line": 134,
          "text": "    if r['energy_hartree'] is None:"
        },
        {
          "line": 135,
          "text": "        r['relative_kj_mol'] = None"
        },
        {
          "line": 136,
          "text": ""
        },
        {
          "line": 137,
          "text": "all_xyz = [c['file'] for c in cands]"
        },
        {
          "line": 138,
          "text": "all_inp = [r['input'] for r in runs]"
        },
        {
          "line": 139,
          "text": "nconv_true = sum(1 for c in cands if c['ff_converged'])"
        },
        {
          "line": 140,
          "text": "dups = [{'candidate': c['id'], 'duplicate_of': c['duplicate_of'],"
        },
        {
          "line": 141,
          "text": "         'min_rmsd_A': c['min_rmsd_A'], 'mmff_energy_kcal_mol': c['mmff_kcal_mol']}"
        },
        {
          "line": 142,
          "text": "        for c in cands if c['duplicate_of']]"
        },
        {
          "line": 143,
          "text": ""
        },
        {
          "line": 144,
          "text": "obs = []"
        },
        {
          "line": 145,
          "text": "obs.append({"
        },
        {
          "line": 146,
          "text": "    'name': 'candidate_conformer_search',"
        },
        {
          "line": 147,
          "text": "    'value': {"
        },
        {
          "line": 148,
          "text": "        'system': 'n-hexane',"
        },
        {
          "line": 149,
          "text": "        'smiles': 'CCCCCC',"
        },
        {
          "line": 150,
          "text": "        'generator': 'RDKit ETKDGv3',"
        },
        {
          "line": 151,
          "text": "        'random_seed': SEED,"
        },
        {
          "line": 152,
          "text": "        'num_conformers_requested': N_EMBED,"
        },
        {
          "line": 153,
          "text": "        'num_conformers_embedded': len(cands),"
        },
        {
          "line": 154,
          "text": "        'force_field': 'MMFF94',"
        },
        {
          "line": 155,
          "text": "        'num_ff_converged': nconv_true,"
        },
        {
          "line": 156,
          "text": "        'duplicate_rmsd_threshold_A': THRESH,"
        },
        {
          "line": 157,
          "text": "        'rmsd_definition': 'heavy_atom_symmetry_aware_best_rmsd_covering_reversed_chain_equivalence',"
        },
        {
          "line": 158,
          "text": "        'candidates': [{'candidate': c['id'], 'xyz_file': c['file'],"
        },
        {
          "line": 159,
          "text": "                        'mmff_energy_kcal_mol': c['mmff_kcal_mol'],"
        },
        {
