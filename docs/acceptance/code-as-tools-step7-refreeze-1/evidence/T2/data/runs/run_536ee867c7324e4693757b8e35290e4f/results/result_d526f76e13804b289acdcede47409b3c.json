          "text": "                        'min_rmsd_to_earlier_kept_A': c['min_rmsd_A']} for c in cands],"
        },
        {
          "line": 163,
          "text": "        'num_unique_clusters': len(kept)"
        },
        {
          "line": 164,
          "text": "    },"
        },
        {
