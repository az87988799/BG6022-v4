        {
          "line": 20,
          "text": "def parse_table(lines):"
        },
        {
          "line": 21,
          "text": "    for i, line in enumerate(lines):"
        },
        {
          "line": 22,
          "text": "        if not GAUGE_HEADER.search(line):"
        },
        {
          "line": 23,
          "text": "            continue"
        },
        {
          "line": 24,
          "text": "        rows = []"
        },
        {
          "line": 25,
          "text": "        header_seen = False"
        },
        {
          "line": 26,
          "text": "        for s in lines[i + 1:i + 600]:"
        },
        {
          "line": 27,
          "text": "            if re.match(r'^\\s*Trans\\.', s, re.I):"
        },
        {
          "line": 28,
          "text": "                header_seen = True"
        },
        {
          "line": 29,
          "text": "                continue"
        },
        {
          "line": 30,
          "text": "            m = ROW.match(s)"
        },
        {
          "line": 31,
          "text": "            if header_seen and m:"
        },
        {
          "line": 32,
          "text": "                rows.append({'state_index': int(m.group(1)),"
        },
        {
          "line": 33,
          "text": "                             'energy_cm1': float(m.group(2)),"
        },
        {
          "line": 34,
          "text": "                             'wavelength_nm': float(m.group(3)),"
        },
        {
          "line": 35,
          "text": "                             'fosc': float(m.group(4))})"
        },
        {
          "line": 36,
          "text": "            elif rows:"
        },
        {
          "line": 37,
          "text": "                break"
        },
        {
          "line": 38,
          "text": "        if rows:"
        },
        {
          "line": 39,
          "text": "            return rows"
        },
        {
          "line": 40,
          "text": "    return []"
        },
        {
          "line": 41,
          "text": ""
        },
        {
          "line": 42,
          "text": ""
        },
        {
          "line": 43,
          "text": "def parse_states(lines):"
        },
        {
          "line": 44,
          "text": "    found = []"
        },
        {
          "line": 45,
          "text": "    for i, line in enumerate(lines):"
        },
        {
          "line": 46,
          "text": "        m = STATE_RE.match(line)"
        },
        {
          "line": 47,
          "text": "        if not m:"
        },
        {
          "line": 48,
          "text": "            continue"
        },
        {
          "line": 49,
          "text": "        vec = None"
        },
        {
          "line": 50,
          "text": "        for s in lines[i + 1:i + 6]:"
        },
        {
          "line": 51,
          "text": "            mm = VEC_RE.match(s)"
        },
        {
          "line": 52,
          "text": "            if mm:"
        },
        {
          "line": 53,
          "text": "                vec = [float(mm.group(1)), float(mm.group(2)), float(mm.group(3))]"
        },
        {
          "line": 54,
          "text": "                break"
        },
        {
          "line": 55,
          "text": "        if vec is None:"
        },
        {
          "line": 56,
          "text": "            continue"
        },
        {
          "line": 57,
          "text": "        e_au = float(m.group(2))"
        },
        {
          "line": 58,
          "text": "        found.append({'state_index': int(m.group(1)),"
        },
        {
          "line": 59,
          "text": "                      'energy_eV': float(m.group(3)),"
        },
        {
          "line": 60,
          "text": "                      'fosc': (2.0 / 3.0) * e_au * sum(v * v for v in vec)})"
        },
        {
          "line": 61,
          "text": "    return found"
        },
        {
          "line": 62,
          "text": ""
        },
        {
          "line": 63,
          "text": ""
        },
        {
          "line": 64,
          "text": "cis = read_lines('job.cis')"
        },
        {
          "line": 65,
          "text": "stdout = read_lines('stdout.out')"
        },
        {
          "line": 66,
          "text": "inp_lines = read_lines('job.inp')"
