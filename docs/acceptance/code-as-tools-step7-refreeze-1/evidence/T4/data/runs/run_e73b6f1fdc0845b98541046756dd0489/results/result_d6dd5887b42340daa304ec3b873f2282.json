        {
          "line": 95,
          "text": ""
        },
        {
          "line": 96,
          "text": "if not excitations:"
        },
        {
          "line": 97,
          "text": "    raise SystemExit('no excitation rows parsed from job.cis or stdout.out')"
        },
        {
          "line": 98,
          "text": ""
        },
        {
          "line": 99,
          "text": "lowest5 = excitations[:5]"
        },
        {
