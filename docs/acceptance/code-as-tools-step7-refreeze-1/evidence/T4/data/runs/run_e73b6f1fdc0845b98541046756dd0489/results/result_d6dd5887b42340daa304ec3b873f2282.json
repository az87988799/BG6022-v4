          "line": 169,
          "text": "             % (method_line, ' | '.join(tddft_lines)))"
        },
        {
          "line": 170,
          "text": ""
        },
        {
          "line": 171,
          "text": "geometry_provenance = ('The geometry consumed by the response calculation is the task-prepared XYZ coords.xyz (%d atoms, '"
