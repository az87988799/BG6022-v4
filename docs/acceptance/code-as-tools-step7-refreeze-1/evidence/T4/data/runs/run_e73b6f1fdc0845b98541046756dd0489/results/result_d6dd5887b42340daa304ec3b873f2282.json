        {
          "line": 149,
          "text": ""
        },
        {
          "line": 150,
          "text": "exc_sources = [{'filename': origin, 'location': ('ABSORPTION SPECTRUM VIA TRANSITION ELECTRIC DIPOLE MOMENTS table' if rows else 'per-STATE energies and length-gauge transition dipoles')}]"
        },
        {
          "line": 151,
          "text": ""
        },
        {
          "line": 152,
          "text": "analysis = ('Parsed %d roots from %s ordered by vertical excitation energy. Lowest five: ' % (len(excitations), origin)) + '; '.join("
