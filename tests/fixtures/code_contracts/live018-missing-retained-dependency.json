          "content": "\"\"\"Ethanol B3LYP/def2-SVP Opt+Freq task with the mandated development fault.\"\"\"\nCODE_TOOLS_DEVELOPMENT_FAULT_V1\nimport json\nimport re\nfrom pathlib import Path\n\nfrom orca_task_sdk import run_orca\n\nROOT = Path.cwd()\ngeometry_source = ROOT / \"geometry.xyz\"\nif not geometry_source.exists():\n    raise FileNotFoundError(\"geometry.xyz dependency is missing\")\n\norca_input = \"\"\"! B3LYP def2-SVP Opt Freq TightSCF NORI NoAutoStart RKS\n%pal\n  nprocs 4\nend\n%maxcore 192\n%scf\n  MaxIter 256\n  ConvForced true\n  AutoTRAH false\nend\n%geom\n  MaxIter 128\n  EnforceStrictConvergence true\nend\n%method\n  Z_MaxIter 128\nend\n* xyzfile 0 1 geometry.xyz\n\"\"\"\ninput_path = ROOT / \"job.inp\"\ninput_path.write_text(orca_input, encoding=\"utf-8\")\n\nreceipt = run_orca(input_path, dependencies=(\"geometry.xyz\",), request_key=\"ethanol_optfreq\")\nfiles = receipt[\"files\"]\n\ndef read_original(name):\n    path = files.get(name)\n    if path is None:\n        return \"\"\n    return Path(path).read_text(errors=\"replace\")\n\nstdout_text = read_original(\"stdout.out\")\nxyz_text = read_original(\"job.xyz\")\n\nfrequencies = []\nin_vibrations = False\nfor line in stdout_text.splitlines():\n    if \"VIBRATIONAL FREQUENCIES\" in line:\n        in_vibrations = True\n        continue\n    if in_vibrations:\n        match = re.search(r\"^\\s*(\\d+):\\s+([-+]?\\d+(?:\\.\\d+)?)\\s+cm\\*\\*-1\", line)\n        if match:\n            frequencies.append(float(match.group(2)))\n        elif \"NORMAL MODES\" in line or \"IR SPECTRUM\" in line:\n            break\n\nif not xyz_text.strip():\n    blocks = stdout_text.split(\"CARTESIAN COORDINATES (ANGSTROEM)\")\n    if len(blocks) > 1:\n        atom_lines = []\n        for line in blocks[-1].splitlines():\n            stripped = line.strip()\n            if re.match(r\"^[A-Za-z]{1,3}\\s+[-+]?\\d\", stripped):\n                atom_lines.append(stripped)\n            elif atom_lines and not stripped:\n                break\n        xyz_text = str(len(atom_lines)) + \"\\noptimized\\n\" + \"\\n\".join(atom_lines) + \"\\n\"\n\nobservations = {\n    \"version\": 1,\n    \"observations\": [\n        {\n            \"name\": \"optimized_geometry\",\n            \"value\": xyz_text,\n            \"unit\": \"angstrom\",\n            \"sources\": [\n                {\n                    \"internal_request_key\": receipt[\"request_key\"],\n                    \"filename\": \"job.xyz\",\n                    \"location\": None,\n                }\n            ],\n            \"limitations\": [\n                \"geometry reported from ORCA Opt+Freq output; scientific qualification not asserted\"\n            ],\n        },\n        {\n            \"name\": \"vibrational_frequencies\",\n            \"value\": frequencies,\n            \"unit\": \"cm^-1\",\n            \"sources\": [\n                {\n                    \"internal_request_key\": receipt[\"request_key\"],\n                    \"filename\": \"stdout.out\",\n                    \"location\": \"VIBRATIONAL FREQUENCIES\",\n                }\n            ],\n            \"limitations\": [\n                \"harmonic frequencies; no empirical scaling; scientific qualification not asserted\"\n            ],\n        },\n    ],\n}\n(ROOT / \"observations.json\").write_text(json.dumps(observations, indent=2), encoding=\"utf-8\")\n",
          "role": "python"
        },
