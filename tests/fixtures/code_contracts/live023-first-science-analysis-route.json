          "content": "import json\nimport hashlib\n\nfiles = {\n    \"gas_input\": \"gas.inp\",\n    \"cpcm_input\": \"cpcm.inp\",\n    \"shared_xyz\": \"coords.xyz\",\n    \"gas_output\": \"gas_stdout.out\",\n    \"cpcm_output\": \"cpcm_stdout.out\"\n}\nmetadata = {}\nfor key, path in files.items():\n    try:\n        with open(path, 'rb') as f:\n            content = f.read()\n            sha = hashlib.sha256(content).hexdigest()\n            metadata[key] = {\"path\": path, \"sha256\": sha, \"size_bytes\": len(content)}\n    except FileNotFoundError:\n        metadata[key] = {\"path\": path, \"error\": \"file not found\"}\n\nobs = {\n    \"version\": 1,\n    \"observations\": [{\n        \"name\": \"artifact_metadata\",\n        \"value\": metadata,\n        \"unit\": None,\n        \"sources\": [],\n        \"formula\": None,\n        \"artifacts\": list(files.values()),\n        \"limitations\": [\"Metadata computed from provided files; original provenance tied to ORCA run and geometry preparation steps.\"]\n    }]\n}\nwith open(\"observations.json\", \"w\") as f:\n    json.dump(obs, f)\n"
