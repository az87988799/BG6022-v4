          "content": "import json\n\ndef extract_energy(filename):\n    with open(filename, 'r') as f:\n        for line in f:\n            if \"FINAL SINGLE POINT ENERGY\" in line:\n                parts = line.split()\n                for p in reversed(parts):\n                    try:\n                        return float(p)\n                    except ValueError:\n                        continue\n    raise ValueError(\"Energy not found in \" + filename)\n\nenergy = extract_energy(\"gas_stdout.out\")\nobs = {\n    \"version\": 1,\n    \"observations\": [{\n        \"name\": \"energy\",\n        \"value\": energy,\n        \"unit\": \"Eh\",\n        \"sources\": [{\"filename\": \"stdout.out\", \"location\": \"line containing FINAL SINGLE POINT ENERGY\"}],\n        \"formula\": None,\n        \"artifacts\": [\"gas_stdout.out\"],\n        \"limitations\": [\"Parsed from ORCA single point output; no additional verification.\"]\n    }]\n}\nwith open(\"observations.json\", \"w\") as f:\n    json.dump(obs, f)\n"
